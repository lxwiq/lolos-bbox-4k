  "remplacements": [
    {
      "paquet": "org.smarttube.stable",
      "nom": "SmartTube",
      "remplace": "com.google.android.youtube.tv",
      "description": "YouTube sans publicités ni sponsors, logiciel libre (github.com/yuliskov/SmartTube). Vous pouvez vous connecter à votre compte YouTube. La dernière version est téléchargée depuis GitHub (≈ 25 Mo), puis YouTube est désactivé (pas désinstallé).",
      "avertissement": "Pour caster depuis l'appli YouTube du téléphone, associez-le dans les réglages de SmartTube (code à saisir sur le téléphone).",
      "depot": "yuliskov/SmartTube",
      "fichier": "SmartTube_stable_"
    }
  ],
  "decouverte": {
    "note": "Les applis de la TV absentes de « paquets » (celles de la liste d'applis et celles installées en plus) sont ajoutées automatiquement dans cette catégorie, actives par défaut.",
    "categorie": "autres"
  },
  "proteges": {
    "note": "Jamais désactivés : chaînes TV, guide, DRM, décodage, télécommande, éligibilité TV, mises à jour, services Google de base.",
