{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LolOS",
  "version": "1.2.0",
  "identifier": "fr.lolos.installateur",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lol'OS",
        "width": 1100,
        "height": 740,
        "minWidth": 940,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Lol'OS : refonte de l'interface de la Bbox 4K — plus rapide, sans pub, accueil façon Apple TV",
    "copyright": "Lol'OS — MIT — non affilié à Bouygues Telecom",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyMEVBRENGMzg4Mjk3N0IKUldSN2w0STR6NjBPd3JweDd1UHpCanA4WCtXSFQybXYyY1RKQ0kzUDlZc0gwY0RRZmhNSno3UXUK",
      "endpoints": [
        "https://github.com/lxwiq/lolos-bbox-4k/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
